# --- Core ---
ENV=development
DATABASE_URL=postgresql+psycopg://jobtrail:jobtrail@localhost:5433/jobtrail

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (comma-separated, never "*") ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Job data source: JSearch via RapidAPI ---
RAPIDAPI_KEY=
JSEARCH_HOST=jsearch.p.rapidapi.com

# --- Email notifications (leave SMTP_HOST blank to log emails to console in dev) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JobTrail <no-reply@jobtrail.app>
APP_BASE_URL=http://localhost:5173

# --- Job source quota controls (free plan is ~200 calls/month) ---
# ISO country code the search is scoped to (JSearch defaults to "us").
JOB_COUNTRY=uk
# Serve identical searches from memory for this many minutes; 0 disables.
JSEARCH_CACHE_TTL_MINUTES=15
# Each digest run costs one API call per followed company.
DIGEST_MAX_COMPANIES=5

# --- Web push (generate with: python -m app.tools.vapid) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Media storage (profile pictures) ---
# "local" writes to backend/media - fine for dev, WIPED on Render/Railway redeploys.
# Use "s3" with Cloudflare R2 (or any S3-compatible service) for deployments.
MEDIA_STORAGE=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Adzuna (optional secondary job source) ---
# Free key from https://developer.adzuna.com/ - leave blank to use JSearch only.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Follow-up reminders ---
# Nudge about applications with no status change in this many days.
FOLLOW_UP_AFTER_DAYS=14
REMINDER_REPEAT_DAYS=7

# --- Optional: shared rate-limit store (needed for >1 worker/instance) ---
REDIS_URL=
